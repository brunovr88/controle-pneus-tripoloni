# Copie este arquivo para .streamlit/secrets.toml (uso local) e NUNCA o comite.
# Em produção (Streamlit Community Cloud), cole o mesmo conteúdo em
# App settings -> Secrets no painel do Streamlit Cloud.

[sheets]
spreadsheet_id = "COLE_AQUI_O_ID_DA_PLANILHA_GOOGLE"

# So usado UMA vez, na tela "Configuracao Inicial": antes do primeiro usuario
# admin existir, essa tela nao tem como exigir login (ninguem existe ainda).
# Esse codigo trava quem pode concluir a configuracao inicial -- defina algo so
# seu, va na tela, configure o sistema, e so entao compartilhe o link do app.
[setup]
codigo = "defina-um-codigo-so-seu-aqui"

# Conteudo do JSON baixado ao criar a Service Account no Google Cloud
# (Menu > IAM e admin > Contas de serviço > Chaves > Adicionar chave > JSON).
[gcp_service_account]
type = "service_account"
project_id = "SEU_PROJECT_ID"
private_key_id = "..."
private_key = "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
client_email = "algo@seu-projeto.iam.gserviceaccount.com"
client_id = "..."
auth_uri = "https://accounts.google.com/o/oauth2/auth"
token_uri = "https://oauth2.googleapis.com/token"
auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
client_x509_cert_url = "..."
